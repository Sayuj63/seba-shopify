<style>
  .scg { background: #fff; padding: 64px 0; }
  .scg__wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .scg__head { margin-bottom: 32px; }
  .scg__eyebrow { font-size: 11px; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 8px; }
  .scg__title { font-size: clamp(22px, 3vw, 32px); font-weight: 800; color: #111827; margin: 0; }
  .scg__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .scg-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 32px 20px;
    border-radius: 14px;
    border: 1.5px solid #e5e7eb;
    text-decoration: none;
    background: #fafafa;
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s, background 0.18s;
    min-height: 150px;
  }
  .scg-card:hover {
    border-color: #2563eb;
    background: #f0f5ff;
    box-shadow: 0 4px 16px rgba(37,99,235,0.10);
    transform: translateY(-2px);
  }
  .scg-card__emoji { font-size: 36px; line-height: 1; }
  .scg-card__name { font-size: 14px; font-weight: 700; color: #111827; text-align: center; line-height: 1.3; }
  .scg-card:hover .scg-card__name { color: #2563eb; }
  .scg-card__count { font-size: 11px; color: #9ca3af; font-weight: 500; }
  @media (max-width: 640px) { .scg__grid { grid-template-columns: repeat(2, 1fr); } .scg { padding: 44px 0; } }
</style>

<section class="scg">
  <div class="scg__wrap">
    <div class="scg__head">
      {%- if section.settings.eyebrow != blank -%}<p class="scg__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="scg__title">{{ section.settings.heading | default: 'Shop by Category' }}</h2>
    </div>

    <div class="scg__grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection_handle] -%}
        <a href="{{ block.settings.link | default: '#' }}" class="scg-card" {{ block.shopify_attributes }}>
          {%- if block.settings.emoji_icon != blank -%}
            <span class="scg-card__emoji" aria-hidden="true">{{ block.settings.emoji_icon }}</span>
          {%- endif -%}
          <span class="scg-card__name">{{ block.settings.heading }}</span>
          {%- if col != blank -%}
            <span class="scg-card__count">{{ col.products_count }} products</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse by Category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        { "type": "text",     "id": "emoji_icon",         "label": "Emoji",            "default": "📺" },
        { "type": "text",     "id": "heading",             "label": "Name",             "default": "TV Accessories" },
        { "type": "url",      "id": "link",                "label": "Link" },
        { "type": "text",     "id": "collection_handle",   "label": "Collection handle (for live count)", "default": "tv-accessories" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category Grid",
      "settings": { "eyebrow": "Browse by Category", "heading": "Shop by Category" },
      "blocks": [
        { "type": "category", "settings": { "emoji_icon": "📺", "heading": "TV Accessories",          "link": "/collections/tv-accessories",          "collection_handle": "tv-accessories" } },
        { "type": "category", "settings": { "emoji_icon": "🎧", "heading": "Headphones",              "link": "/collections/headphones",              "collection_handle": "headphones" } },
        { "type": "category", "settings": { "emoji_icon": "💾", "heading": "Storage Devices",         "link": "/collections/storage-devices",         "collection_handle": "storage-devices" } },
        { "type": "category", "settings": { "emoji_icon": "📱", "heading": "Phone Accessories",       "link": "/collections/phone-accessories",       "collection_handle": "phone-accessories" } },
        { "type": "category", "settings": { "emoji_icon": "💿", "heading": "DVD & Blu-ray Media",     "link": "/collections/dvd-media",               "collection_handle": "dvd-media" } },
        { "type": "category", "settings": { "emoji_icon": "🔊", "heading": "Home Entertainment",      "link": "/collections/home-entertainment",      "collection_handle": "home-entertainment" } }
      ]
    }
  ]
}
{% endschema %}
