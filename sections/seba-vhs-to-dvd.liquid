<style>
  .svd {
    background: #fffbeb;
    padding: 72px 0;
    border-top: 1px solid #fde68a;
    border-bottom: 1px solid #fde68a;
  }
  .svd__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* Content side */
  .svd__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    color: #b45309;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
  }
  .svd__eyebrow-dot { width: 6px; height: 6px; background: #d97706; border-radius: 50%; }

  .svd__title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 6px;
  }
  .svd__trust {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fef3c7;
    border: 1px solid #fde68a;
    color: #92400e;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 8px;
    margin-bottom: 16px;
  }
  .svd__sub {
    font-size: 15px;
    color: #6b7280;
    line-height: 1.65;
    margin: 0 0 24px;
  }

  /* Price highlight */
  .svd__price-banner {
    background: #fff;
    border: 2px solid #fde68a;
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .svd__price-amount {
    font-size: 36px;
    font-weight: 900;
    color: #d97706;
    line-height: 1;
    white-space: nowrap;
  }
  .svd__price-label {
    font-size: 13px;
    color: #374151;
    font-weight: 500;
    line-height: 1.45;
  }
  .svd__price-label strong { display: block; font-size: 14px; font-weight: 700; color: #111827; }

  /* Format chips */
  .svd__formats-label {
    font-size: 12px;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .svd__formats {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 24px;
  }
  .svd__format-chip {
    background: #fff;
    border: 1.5px solid #e5e7eb;
    color: #374151;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 8px;
  }

  /* Checklist */
  .svd__checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 28px;
  }
  .svd__check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #374151;
  }
  .svd__check-tick {
    width: 20px; height: 20px;
    background: #d1fae5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .svd__check-tick svg { width: 11px; height: 11px; stroke: #16a34a; stroke-width: 2.5; }

  /* CTA */
  .svd__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .svd__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #d97706;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 13px 22px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
    white-space: nowrap;
  }
  .svd__cta-btn:hover { background: #b45309; transform: translateY(-1px); }
  .svd__cta-phone {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    text-decoration: none;
    transition: color 0.15s;
  }
  .svd__cta-phone:hover { color: #d97706; }
  .svd__cta-phone svg { width: 16px; height: 16px; stroke: #d97706; }

  /* Visual side */
  .svd__visual {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .svd__img-wrap {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #f3f4f6;
    position: relative;
  }
  .svd__img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .svd__img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
  }

  /* Steps */
  .svd__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .svd__step {
    background: #fff;
    border: 1.5px solid #fde68a;
    border-radius: 12px;
    padding: 14px 12px;
    text-align: center;
  }
  .svd__step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px; height: 28px;
    background: #d97706;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    border-radius: 50%;
    margin: 0 auto 8px;
  }
  .svd__step-text { font-size: 12px; font-weight: 600; color: #374151; line-height: 1.35; }

  @media (max-width: 900px) {
    .svd__wrap { grid-template-columns: 1fr; gap: 36px; }
    .svd { background: #fff; padding: 48px 0; border-color: #e5e7eb; }
    .svd__trust { background: #fef3c7; }
  }
  @media (max-width: 480px) {
    .svd__wrap { padding: 0 16px; }
    .svd__checks { grid-template-columns: 1fr; }
    .svd__cta { flex-direction: column; align-items: flex-start; }
    .svd__steps { grid-template-columns: 1fr; gap: 8px; }
  }
</style>

<section class="svd">
  <div class="svd__wrap">

    {%- comment -%} Content left {%- endcomment -%}
    <div class="svd__content">
      <div class="svd__eyebrow">
        <span class="svd__eyebrow-dot"></span>
        {{ section.settings.eyebrow | default: 'Media Transfer Service' }}
      </div>

      <h2 class="svd__title">{{ section.settings.title | default: 'Convert & Transfer VHS to DVD' }}</h2>

      <div class="svd__trust">
        ⭐ {{ section.settings.trust_text | default: 'Trusted for Over 30 Years' }}
      </div>

      <p class="svd__sub">{{ section.settings.description | default: 'Bring your treasured memories back to life. We specialise in converting old video tapes into high-quality DVDs, helping you preserve your precious family memories for generations to come.' }}</p>

      <div class="svd__price-banner">
        <div class="svd__price-amount">{{ section.settings.price | default: '£6' }}</div>
        <div class="svd__price-label">
          <strong>{{ section.settings.price_label | default: 'Per tape — all formats accepted' }}</strong>
          {{ section.settings.price_sub | default: 'Free quote — no obligation' }}
        </div>
      </div>

      <p class="svd__formats-label">Formats we convert:</p>
      <div class="svd__formats">
        {%- assign formats = section.settings.formats | default: 'VHS,VHS-C,Video8,Hi8,Digital8,MiniDV,Mini DVD,Betamax' | split: ',' -%}
        {%- for fmt in formats -%}
          <span class="svd__format-chip">{{ fmt | strip }}</span>
        {%- endfor -%}
      </div>

      <div class="svd__checks">
        {%- assign checks = section.settings.checklist | default: 'Fast turnaround,High-quality transfers,Affordable prices,30+ years experience,Free quote,Trusted service' | split: ',' -%}
        {%- for item in checks -%}
          <div class="svd__check">
            <div class="svd__check-tick">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            {{ item | strip }}
          </div>
        {%- endfor -%}
      </div>

      <div class="svd__cta">
        <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="svd__cta-btn">
          📼 {{ section.settings.cta_label | default: 'Book a Transfer' }}
        </a>
        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="svd__cta-phone">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.19 12 19.79 19.79 0 0 1 1.08 3.18 2 2 0 0 1 3.05 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {{ section.settings.phone }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Visual right {%- endcomment -%}
    <div class="svd__visual">
      <div class="svd__img-wrap">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 700 | image_tag: alt: 'VHS to DVD transfer', loading: 'lazy' }}
        {%- else -%}
          <div class="svd__img-placeholder">📼</div>
        {%- endif -%}
      </div>

      <div class="svd__steps">
        <div class="svd__step">
          <div class="svd__step-num">1</div>
          <div class="svd__step-text">Send or drop off your tapes</div>
        </div>
        <div class="svd__step">
          <div class="svd__step-num">2</div>
          <div class="svd__step-text">We transfer to DVD or digital</div>
        </div>
        <div class="svd__step">
          <div class="svd__step-num">3</div>
          <div class="svd__step-text">Receive your memories back</div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "VHS to DVD Transfer",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image",        "label": "Image" },
    { "type": "text",         "id": "eyebrow",      "label": "Eyebrow",           "default": "Media Transfer Service" },
    { "type": "text",         "id": "title",        "label": "Heading",           "default": "Convert & Transfer VHS to DVD" },
    { "type": "text",         "id": "trust_text",   "label": "Trust badge",       "default": "Trusted for Over 30 Years" },
    { "type": "textarea",     "id": "description",  "label": "Description",       "default": "Bring your treasured memories back to life. We specialise in converting old video tapes into high-quality DVDs, helping you preserve your precious family memories for generations to come." },
    { "type": "text",         "id": "price",        "label": "Price",             "default": "£6" },
    { "type": "text",         "id": "price_label",  "label": "Price label",       "default": "Per tape — all formats accepted" },
    { "type": "text",         "id": "price_sub",    "label": "Price sub-text",    "default": "Free quote — no obligation" },
    { "type": "text",         "id": "formats",      "label": "Formats (comma-separated)", "default": "VHS,VHS-C,Video8,Hi8,Digital8,MiniDV,Mini DVD,Betamax" },
    { "type": "text",         "id": "checklist",    "label": "Checklist items (comma-separated)", "default": "Fast turnaround,High-quality transfers,Affordable prices,30+ years experience,Free quote,Trusted service" },
    { "type": "text",         "id": "cta_label",    "label": "Button label",      "default": "Book a Transfer" },
    { "type": "url",          "id": "cta_link",     "label": "Button link" },
    { "type": "text",         "id": "phone",        "label": "Phone number",      "default": "07404 944044" }
  ],
  "presets": [
    {
      "name": "VHS to DVD Transfer",
      "settings": {
        "title": "Convert & Transfer VHS to DVD",
        "phone": "07404 944044"
      }
    }
  ]
}
{% endschema %}
