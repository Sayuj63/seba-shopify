<style>
  .spb {
    background: #fff;
    padding: 64px 0;
  }
  .spb__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .spb__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  /* Card */
  .spb-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 36px 36px 36px;
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .spb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 56px rgba(0,0,0,0.22);
  }

  /* Gradient fills per colour */
  .spb-card--red    { background: linear-gradient(145deg, #7f1d1d 0%, #b91c1c 55%, #ef4444 100%); }
  .spb-card--purple { background: linear-gradient(145deg, #3b0764 0%, #6d28d9 55%, #a855f7 100%); }
  .spb-card--blue   { background: linear-gradient(145deg, #0c1a4e 0%, #1d4ed8 55%, #3b82f6 100%); }
  .spb-card--green  { background: linear-gradient(145deg, #052e16 0%, #15803d 55%, #22c55e 100%); }
  .spb-card--orange { background: linear-gradient(145deg, #431407 0%, #c2410c 55%, #f97316 100%); }
  .spb-card--navy   { background: linear-gradient(145deg, #020617 0%, #0f172a 55%, #1e3a5f 100%); }

  /* Geometric decorative circle */
  .spb-card__deco {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: rgba(255,255,255,0.07);
    pointer-events: none;
    transition: transform 0.4s ease;
  }
  .spb-card__deco-2 {
    position: absolute;
    bottom: -80px;
    left: -40px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
    pointer-events: none;
  }
  .spb-card:hover .spb-card__deco {
    transform: scale(1.1) translate(-8px, 8px);
  }

  /* Dot grid overlay */
  .spb-card__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
  }

  /* Emoji icon */
  .spb-card__icon {
    position: absolute;
    top: 28px;
    right: 32px;
    font-size: 52px;
    line-height: 1;
    opacity: 0.9;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  .spb-card:hover .spb-card__icon {
    transform: scale(1.12) rotate(-4deg);
  }

  /* Content */
  .spb-card__content { position: relative; z-index: 2; }
  .spb-card__label {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    padding: 4px 10px;
    border-radius: 20px;
    margin-bottom: 12px;
  }
  .spb-card__heading {
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 800;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .spb-card__subtext {
    font-size: 14px;
    color: rgba(255,255,255,0.75);
    line-height: 1.55;
    margin: 0 0 24px;
    max-width: 340px;
  }
  .spb-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.18);
    border: 1.5px solid rgba(255,255,255,0.35);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 10px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.18s, border-color 0.18s, gap 0.18s;
    white-space: nowrap;
  }
  .spb-card:hover .spb-card__cta {
    background: rgba(255,255,255,0.28);
    border-color: rgba(255,255,255,0.55);
    gap: 11px;
  }
  .spb-card__cta svg { flex-shrink: 0; }

  /* Responsive */
  @media (max-width: 768px) {
    .spb__grid { grid-template-columns: 1fr; }
    .spb-card { min-height: 240px; padding: 28px 24px 28px; }
    .spb { padding: 44px 0; }
    .spb-card__icon { font-size: 40px; top: 20px; right: 22px; }
  }
</style>

<section class="spb">
  <div class="spb__wrap">
    <div class="spb__grid">

      {%- for block in section.blocks -%}
        {%- assign color = block.settings.color | default: 'blue' -%}
        {%- assign link  = block.settings.cta_link | default: '#' -%}

        <a href="{{ link }}" class="spb-card spb-card--{{ color }}" {{ block.shopify_attributes }}>

          <div class="spb-card__deco"></div>
          <div class="spb-card__deco-2"></div>
          <div class="spb-card__dots"></div>

          {%- if block.settings.icon != blank -%}
            <span class="spb-card__icon">{{ block.settings.icon }}</span>
          {%- endif -%}

          <div class="spb-card__content">
            {%- if block.settings.label != blank -%}
              <span class="spb-card__label">{{ block.settings.label }}</span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="spb-card__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.subtext != blank -%}
              <p class="spb-card__subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="spb-card__cta">
                {{ block.settings.cta_label }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            {%- endif -%}
          </div>

        </a>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banners",
  "tag": "section",
  "blocks": [
    {
      "type": "banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "💿",
          "info": "Paste any emoji e.g. 💿 🎧 📱 💾"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (small pill above heading)",
          "default": "Great Value"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "DVD & Blu-ray Media"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "TDK, Verbatim & Panasonic. Bulk packs available."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Colour scheme",
          "default": "red",
          "options": [
            { "value": "red",    "label": "Red" },
            { "value": "purple", "label": "Purple" },
            { "value": "blue",   "label": "Blue" },
            { "value": "green",  "label": "Green" },
            { "value": "orange", "label": "Orange" },
            { "value": "navy",   "label": "Navy" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Promo Banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "icon": "💿",
            "label": "Great Value Packs",
            "heading": "DVD & Blu-ray Media",
            "subtext": "TDK, Verbatim & Panasonic. Bulk packs from £5.99.",
            "cta_label": "Shop Media",
            "cta_link": "/collections/dvd-media",
            "color": "red"
          }
        },
        {
          "type": "banner",
          "settings": {
            "icon": "🎧",
            "label": "Premium Audio",
            "heading": "Headphones & Earphones",
            "subtext": "Wireless, noise-cancelling & in-ear from £7.99.",
            "cta_label": "Shop Headphones",
            "cta_link": "/collections/headphones",
            "color": "purple"
          }
        }
      ]
    }
  ]
}
{% endschema %}
